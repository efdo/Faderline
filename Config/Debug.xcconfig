// Debug-only app identity. Keeps local builds from sharing the installed
// release's bundle ID, microphone (TCC) grant, and saved mixer preferences.
// Release builds are unaffected and keep com.faderline.app.
PRODUCT_BUNDLE_IDENTIFIER = com.faderline.app.debug

// Optional, git-ignored per-machine signing settings. Copy
// DebugLocal.xcconfig.example to DebugLocal.xcconfig to sign Debug builds with
// a stable Apple Development certificate so macOS keeps the microphone grant
// across rebuilds. Without it, Debug builds are ad-hoc signed.
#include? "DebugLocal.xcconfig"
